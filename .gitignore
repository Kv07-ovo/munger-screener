.venv/
__pycache__/
*.pyc
.DS_Store
backup/

# 运行结果：保留目录、忽略内容
# 注意：data/stocks.csv 与 data/annual_financials.csv 暂不忽略，应纳入版本管理。
output/*
!output/.gitkeep

# 数据备份文件（保留 stocks.csv 和 annual_financials.csv 本体）
data/*_backup_*.csv
.claude/settings.local.json
output/*.csv
output/*.xlsx

# v2.3.0-alpha3：自动生成的研究卡片（保留目录与手写 *_report.txt）
research_notes/*_card.md
!research_notes/.gitkeep

# v2.4.0：密钥/隐私（如 Tushare token 等），永不入库
.env
*.env

# Web 前端（React/Vite）：依赖与构建产物不入库
web_frontend/node_modules/
web_frontend/dist/

# 设计稿与本地草稿，永不入库（视觉真值，仅本地参考）
移动端7/
桌面端6/
screen.png
backups/

# 本地 Claude 技能产物（安装的技能包与锁文件，类似 node_modules）。
# 不忽略整个 .claude/；.claude/agents/*.md 暂保留，后续再决定是否入库。
.agents/
.claude/skills/

# Keep project Claude Code skills versioned
!.claude/skills/
!.claude/skills/**

skills-lock.json
